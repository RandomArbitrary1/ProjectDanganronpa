[gd_scene format=3 uid="uid://617ht2vs8k0g"]

[sub_resource type="GDScript" id="GDScript_cxnql"]
resource_name = "Music"
script/source = "extends AudioStreamPlayer

var current = \"\"
var timer = 0

func switch(file : String, delay = 0.0):
	if current != file:
		current = file
		self.stream = load(file)
		timer = delay
		

func _process(delta: float) -> void:
	if timer > 0:
		timer -= delta
	elif not self.playing:
		self.play()
"

[node name="Music" type="AudioStreamPlayer" unique_id=1656324941]
process_mode = 3
volume_db = -8.0
bus = &"Music"
script = SubResource("GDScript_cxnql")
