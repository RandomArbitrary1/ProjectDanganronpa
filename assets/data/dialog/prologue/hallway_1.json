		{
			"character": "shion",
			"content": "..! There are more people?",
			"expression": "neutral.png",
			"flags": [
				"idea"
			],
			"type": "text"
		},
		{
			"character": "rikuno",
			"content": "Let's talk to them and see if they know anything. For all we know they might be kidnapped too.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Rikuno and I make our way to the new group of people...",
			"expression": "neutral.png",
			"flags": [
				"thought"
			],
			"type": "text"
		},
		{
			"character": "rikuno",
			"content": "Hey, do you guys know what's going on?",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "nori",
			"content": "Ah, hi. Not really actually, that's what we're all wondering.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "tenga",
			"content": "Yeah, sorry to say but we don't know anything.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "naeri",
			"content": "But you girls don't recall anything either?",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "We don't, that's why we're asking.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shuuto",
			"content": "How strange, we all woke up and know nothing. Something fishy is going on.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "amia",
			"content": "... So what now? We all showed up here somehow, and are stuck in a place unknown?",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "itsuki",
			"content": "Well if we're in this together, we probably should team up and introduce ourselves.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "ayuka",
			"content": "That does seem to be the most logical reasonable action.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "reoto",
			"content": "You're probably right. If we team up we can get out of here together!",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "So we're gonna introduce ourselves to eachother? That's a good point to be honest.",
			"expression": "neutral.png",
			"flags": [
				"thought"
			],
			"type": "text"
		},
		{
