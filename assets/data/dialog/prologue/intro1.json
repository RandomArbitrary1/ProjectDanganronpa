		{
			"character": "shion",
			"content": "Alone.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I've always been alone. That's the kind of person I'm cursed to be.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "When I do anything. I end up alone. When I try to do anything. I will always end up alone.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "That's a belief I've held my whole life.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"flags": [],
			"song": "claustrophobic",
			"type": "music"
		},
		{
			"character": "shion",
			"content": "Where am I...? I can't see anything.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "What was I doing before? Think, think, think...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I can't recall anything.",
			"expression": "neutral.png",
			"flags": [
				"idea",
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I don't like this one bit, I'm starting to freak out.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Slowly I start moving and fidgeting until...",
			"expression": "neutral.png",
			"flags": [
				"thought",
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Ah! There's a door handle here. If I can just open it...",
			"expression": "neutral.png",
			"flags": [
				"idea",
				"unknown"
			],
			"type": "text"
		},
		{
			"flags": [],
			"song": "casual",
			"type": "music"
		},
		{
			"file": "res://assets/audio/sfx/environment/creaky_door1.mp3",
			"flags": [],
			"type": "sfx"
		},
		{
			"character": "shion",
			"content": "...!",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"default": false,
			"dialog": "",
			"file": "res://scenes/rooms/classroom.tscn",
			"flags": [],
			"name": "",
			"type": "room"
		},
		{
			"character": "shion",
			"content": "This is a... classroom? I don't recognize it from anywhere. How strange...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Before I go any farther I should introduce myself.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"enabled": true,
			"file": "res://assets/textures/characters/shion/neutral.png",
			"flags": [],
			"type": "cg"
		},
		{
			"character": "shion",
			"content": "I am Shion Fumihiro, the Ultimate Spy.",
			"expression": "neutral.png",
			"flags": [
				"idea",
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"flags": [],
			"type": "intro"
		},
		{
			"character": "shion",
			"content": "My title as an ultimate spy comes from my history working as a spy. Also because it's an ability I own.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Working plenty for various businesses and even the American Government.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Sometimes though, I wish I was better at something else. Because...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I don't like being known for spying on people. It makes me feel like an outcast.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"enabled": false,
			"file": "",
			"flags": [],
			"type": "cg"
		},
		{
			"character": "shion",
			"content": "Enough about me, let's check out what kind of situation I'm in.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Welcome to the game!",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "To rotate the camera, hold the right mouse button and move the mouse.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "To interact with an object, move the cursor to the object and press with the left mouse button.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "To exit a room, press 'R' and select with the left mouse button.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Press F3 to review the controls. Good luck!",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		}
	]
