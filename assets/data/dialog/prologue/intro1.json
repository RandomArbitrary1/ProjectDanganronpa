		{
			"character": "shion",
			"content": "Alone.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I've always been alone. That's the kind of person I'm cursed to be.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "When I do anything. I end up alone. When I try to do anything. I will always end up alone.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "That's a belief I've held my whole life.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"flags": [],
			"song": "Claustrophobic",
			"type": "music"
		},
		{
			"character": "shion",
			"content": "Where am I...? I don't recognize this place at all.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "It seems something happened before I came here.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "What was I doing before? Think, think, think...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
