			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "When I do anything. I end up alone. When I try to do anything. I will always end up alone.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "That's what I am, that's who I will ever be.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
