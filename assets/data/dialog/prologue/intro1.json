				"idea",
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"flags": [],
			"type": "intro"
		},
		{
			"character": "shion",
			"content": "My title as an ultimate spy comes from my history working as a spy. Also because it's an ability I own.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Working plenty for various businesses and even the American Government.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Sometimes though, I wish I was better at something else. Because...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I don't like being known for spying on people. It makes me feel like an outcast.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"enabled": false,
			"file": "",
			"flags": [],
			"type": "cg"
		},
		{
			"character": "shion",
			"content": "Enough about me, let's check out what kind of situation I'm in.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Welcome to the game! We would like to introduce you to the controls.",
