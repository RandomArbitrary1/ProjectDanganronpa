			"flags": [
				"idea"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I don't like this one bit, I'm starting to freak out.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Slowly I start moving and fidgeting until...",
			"expression": "neutral.png",
			"flags": [
				"thought"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Ah! There's a door handle here. If I can just open it...",
			"expression": "neutral.png",
			"flags": [
				"idea"
			],
			"type": "text"
		},
		{
			"flags": [],
			"song": "beautiful_lie",
			"type": "music"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...!",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "This is a... classroom? I don't recognize it from anywhere. How strange...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Before I go any farther I should introduce myself.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I am Shion Fumihiro, the ultimate Spy.",
			"expression": "neutral.png",
			"flags": [
				"idea"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "My title as an ultimate spy comes from my ability to blend in perfectly. Thus I get a lot of opportunities.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Like listening in on people or knowing what to say to avoid any if all trouble.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Sometimes though, I wish I was better at something else. Because...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I don't like being known for spying on people. It makes me feel like an outcast.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Enough about me, let's check out what kind of situation I'm in.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		}
	]
