			"flags": [
				"thought",
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Ah! There's a door handle here. If I can just open it...",
			"expression": "neutral.png",
			"flags": [
				"idea",
				"unknown"
			],
			"type": "text"
		},
		{
			"flags": [],
