			"type": "music"
		},
		{
			"character": "shion",
			"content": "Wait, where am I...? I can't see anything in front of me.",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "What was I doing before? Think, think, think...",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
