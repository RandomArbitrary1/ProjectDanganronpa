{
	"dialog": [
		{
			"character": "shion",
			"content": "Alone. No matter what I do, I always end up alone.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "When I try to do anything to change it, I end up alone.",
