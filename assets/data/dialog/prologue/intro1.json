			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "That's a belief I've held all my life.",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "...",
			"expression": "neutral.png",
			"flags": [],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Where am I...? I don't recognize this place at all.",
