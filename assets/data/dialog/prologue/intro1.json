			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "I really can't recall anything. What in the world is happening?",
			"expression": "neutral.png",
			"flags": [
				"unknown"
			],
			"type": "text"
		},
		{
			"character": "shion",
			"content": "Did I get knocked out and then brought here somehow?",
