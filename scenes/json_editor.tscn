resource_name = "json editor"
script/source = "extends Control

@onready var context_menu = self.get_node(\"Context_menu\")
@onready var navigation = self.get_node(\"Navigation\")
@onready var file_dialog = self.get_node(\"FileDialog\")
@onready var file_dialog_save = self.get_node(\"FileDialogSave\")
@onready var list = self.get_node(\"Items/List\")
@onready var flags_popup: Window = $Flags
@onready var dialogs_popup: Window = $Dialog
@onready var dialogs_tabs: TabBar = $Dialogs_tabs



@onready var dialog_line = list.get_node(\"Dialog\").duplicate()
@onready var visible_line = list.get_node(\"Visibility\").duplicate()
@onready var focus_line = list.get_node(\"Focus\").duplicate()
@onready var music_line = list.get_node(\"Music\").duplicate()
@onready var bullet_line = list.get_node(\"Bullet\").duplicate()
@onready var choice_line = list.get_node(\"Choice\").duplicate()
@onready var cg_line = list.get_node(\"CG\").duplicate()
@onready var sfx_line = list.get_node(\"SFX\").duplicate()
@onready var flag_button = flags_popup.get_node(\"FlagList/FlagItems/FlagOption\").duplicate()
@onready var dialog_button = dialogs_popup.get_node(\"DialogList/DialogItems/DialogOption\").duplicate()

var characters = preload(\"res://assets/data/characters/characters.json\").data

var flags = [\"thought\", \"rage\", \"idea\", \"shock\"]
var flag_current = []
var data = {\"dialog\":[]}
var file_path = \"\"
var moving = null
var to_open = \"data\"

var current_dialog = \"dialog\"

func _ready() -> void:
	Input.set_custom_mouse_cursor(null)
	flags_popup.close_requested.connect(flags_popup.hide)
	dialogs_popup.close_requested.connect(dialogs_popup.hide)
	
	dialog_line.get_node(\"Character/Name\").clear()
	for key in characters.keys():
		dialog_line.get_node(\"Character/Name\").add_item(key)
	
	navigation.get_node(\"Choose\").pressed.connect(func():
		dialogs_popup.visible = true
	)
	dialogs_popup.get_node(\"Insert\").pressed.connect(func():
		for i in data.keys().size():
			if not data.has(\"dialog\" + str(i+1)):
				data[\"dialog\" + str(i+1)] = []
				var new = dialog_button.duplicate()
				dialogs_tabs.add_tab(\"dialog\" + str(i+1))
				dialogs_popup.get_node(\"DialogList/DialogItems\").add_child(new)
				dialogs_options(new, \"dialog\" + str(i+1))
				return
	)
	
	dialogs_tabs.tab_changed.connect(func(tab):
		if tab == 0:
			current_dialog = \"dialog\"
		else:
			current_dialog = \"dialog\" + str(tab)
		reload_list()
	)
	
	flags_popup.get_node(\"FlagList/FlagItems/FlagOption\").queue_free()
	dialogs_popup.get_node(\"DialogList/DialogItems/DialogOption\").queue_free()
	
	for i in list.get_children():
		if i:
			i.queue_free()
	for i in flags:
		var flag_opt = flag_button.duplicate()
		flag_opt.text = i
		flag_opt.name = i
		flags_popup.get_node(\"FlagList/FlagItems\").add_child(flag_opt)
	
	for i in flags_popup.get_node(\"FlagList/FlagItems\").get_children():
		i.pressed.connect(func():
			if flag_current.flags.has(i.name):
				flag_current.flags.remove_at(flag_current.flags.find(i.name))
				i.get_node(\"Outline\").visible = false
			else:
				flag_current.flags.append(i.name)
				i.get_node(\"Outline\").visible = true
		)
	
	navigation.get_node(\"Load\").pressed.connect(func():
		to_open = \"data\"
		file_dialog.set_filters([\"*.json\"])
		file_dialog.root_subfolder = \"assets/data\"
		file_dialog.visible = true
		
	)
	navigation.get_node(\"Save_as\").pressed.connect(func():
		file_dialog_save.visible = true
		file_dialog.root_subfolder = \"assets/data\"
	)
	context_menu.id_pressed.connect(func(id):
		if id == 0:
			var new = dialog_line.duplicate()
			list.add_child(new)
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"text\",\"character\":\"shion\",\"expression\":\"neutral.png\",\"content\":\"\",\"flags\":[]})
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 1:
			var new = visible_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"visible\",\"value\":true,\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 2:
			var new = focus_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"focus\",\"object\":\"default\",\"point\":\"\",\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 3:
			var new = music_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"music\",\"song\":\"angst\",\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 11:
			var new = bullet_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"bullet\",\"show\":true,\"file\":\"\",\"bullet\":\"\",\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 10:
			var new = choice_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"choice\",\"options\":[],\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 14:
			var new = cg_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"cg\",\"enabled\":true,\"file\":\"\",\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
		elif id == 15:
			var new = sfx_line.duplicate()
			data[current_dialog].append({\"id\":data[current_dialog].size(),\"eline\":new,\"type\":\"sfx\",\"file\":\"\",\"flags\":[]})
			list.add_child(new)
			run_options(new,data[current_dialog][data[current_dialog].size()-1])
	)
	file_dialog.file_selected.connect(func(path):
		file_dialog.root_subfolder = \"assets\"
		if to_open == \"data\":
			current_dialog = \"dialog\"
			file_path = path
			navigation.get_node(\"File\").text = path.get_file()
			data = load(path).data
			for i in data[current_dialog].size():
				data[current_dialog][i][\"id\"] = i
			dialogs_tabs.clear_tabs()
			for i in dialogs_popup.get_node(\"DialogList/DialogItems\").get_children():
				if i.name != \"Base\":
					i.queue_free()
					dialogs_tabs.remove_tab(i.get_index())
			dialogs_tabs.add_tab(\"Base dialog\")
			for i in data.keys().size():
				if data.has(\"dialog\" + str(i+1)):
					var new = dialog_button.duplicate()
					dialogs_tabs.add_tab(\"dialog\" + str(i+1))
					dialogs_popup.get_node(\"DialogList/DialogItems\").add_child(new)
					dialogs_options(new, \"dialog\" + str(i+1))
			for a in data.keys().size():
				print(\"dialog\" + str(a),data.has(\"dialog\" + str(a)))
				if data.has(\"dialog\" + str(a)):
					for i in data[\"dialog\" + str(a)].size():
						data[\"dialog\" + str(a)][i][\"id\"] = i
			print(data)
			reload_list()
	)
	file_dialog_save.file_selected.connect(func(path):
		file_dialog.root_subfolder = \"assets\"
		var file = FileAccess.open(path, FileAccess.WRITE)
		if file:
			file.store_string(JSON.stringify(data, \"\\t\"))
			navigation.get_node(\"File\").text = path.get_file()
			file_path = path
			file.close()
			self.get_node(\"Saved/Anim\").play(\"Anim\")
	)
	navigation.get_node(\"Save\").pressed.connect(save)
	navigation.get_node(\"Clear\").pressed.connect(func():
		if navigation.get_node(\"Clear\").text == \"yes?\":
			data = {\"dialog\":[]}
			navigation.get_node(\"Clear\").text = \"Clear all\"
			for i in list.get_children():
				i.queue_free()
		else:
			navigation.get_node(\"Clear\").text = \"yes?\"
	)
	navigation.get_node(\"Clear\").mouse_exited.connect(func():
		navigation.get_node(\"Clear\").text = \"Clear all\"
	)
	
func dialogs_options(item, id):
	item.get_node(\"Activate\").text = id
	item.get_node(\"Clear\").pressed.connect(func():
		if current_dialog == \"dialog\" + str(item.get_index()):
			current_dialog = \"dialog\"
		data.erase(id)
		print(item.get_index())
		dialogs_tabs.remove_tab(item.get_index())
		item.queue_free()
	)
	
func get_option_id(button: OptionButton, text: String) -> int:
	for i in button.get_item_count():
		if button.get_item_text(i) == text:
			return i
	return -1

func reload_list():
	for i in list.get_children():
		i.queue_free()
	for i in data[current_dialog]:
		if i.type == \"text\":
			var new = dialog_line.duplicate()
			new.get_node(\"Panel/TextEdit\").text = i.content
			new.get_node(\"Character/Name\").selected = range(new.get_node(\"Character/Name\").item_count).map(func(ii): return new.get_node(\"Character/Name\").get_item_text(ii)).find(i.character)
			new.get_node(\"Character/Emotion\").selected = range(new.get_node(\"Character/Emotion\").item_count).map(func(ii): return new.get_node(\"Character/Emotion\").get_item_text(ii)).find(i.expression)
			i[\"eline\"] = new
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"visible\":
			var new = visible_line.duplicate()
			new.get_node(\"Panel/CheckButton\").toggle_mode = i.value
			i[\"eline\"] = new
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"focus\":
			var new = focus_line.duplicate()
			new.get_node(\"Panel/Type\").selected = get_option_id(new.get_node(\"Panel/Type\"),i.object)
			new.get_node(\"Panel/LineEdit\").text = i.point
			i[\"eline\"] = new
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"music\":
			var new = music_line.duplicate()
			i[\"eline\"] = new
			new.get_node(\"Panel/Song\").selected = get_option_id(new.get_node(\"Panel/Song\"),i.song)
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"cg\":
			var new = cg_line.duplicate()
			i[\"eline\"] = new
			new.get_node(\"Panel/CheckButton\").toggle_mode = i.enabled
			if \"file\" in i and ResourceLoader.exists(i.file):
				new.get_node(\"Panel/Load\").text = i.file
				new.get_node(\"Image/TextureRect\").texture = load(i.file)
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"sfx\":
			var new = sfx_line.duplicate()
			i[\"eline\"] = new
			if \"file\" in i and ResourceLoader.exists(i.file):
				new.get_node(\"Panel/Load\").text = i.file
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"choice\":
			var new = choice_line.duplicate()
			i[\"eline\"] = new
			for c in 5:
				if i.options.size() > c:
					var box = new.get_node(\"Panel/Options\").get_child(c)
					box.get_node(\"Text\").text = i.options[c].text
					box.get_node(\"Dialog\").text = i.options[c].dialog
			list.add_child(new)
			run_options(new, i)
		elif i.type == \"bullet\":
			var new = bullet_line.duplicate()
			i[\"eline\"] = new
			new.get_node(\"Panel/CheckButton\").button_pressed = i.show
			new.get_node(\"Panel/Load\").text = i.file.get_file()
			new.get_node(\"Panel/Bullet\").clear()
			var file = null
			if i.file != \"\":
				print(i.file)
				file = load(i.file).data
				if file is Dictionary:
					for key in file.keys():
						new.get_node(\"Panel/Bullet\").add_item(key)
			if file:
				new.get_node(\"Panel/Bullet\").selected = file.keys().find(i.bullet)
			list.add_child(new)
			run_options(new, i) 
	
func run_options(i, item_data):
	i.get_node(\"Panel/Flags\").pressed.connect(func():
		flag_current = item_data
		for ii in flags_popup.get_node(\"FlagList/FlagItems\").get_children():
			if item_data.flags.has(ii.name):
				ii.get_node(\"Outline\").visible = true
			else:
				ii.get_node(\"Outline\").visible = false
		flags_popup.visible = true
	)
	i.get_node(\"Panel/Down\").button_down.connect(func():
		i.get_node(\"Panel/Outline\").visible = true
		i.mouse_filter = Control.MOUSE_FILTER_IGNORE
		moving = i
	)
	i.get_node(\"Panel/Remove\").pressed.connect(func():
		data[current_dialog].remove_at(item_data.id)
		i.queue_free()
	)
	if item_data.type == \"text\":
		i.get_node(\"Character/Emotion\").clear()
		for expr in DirAccess.get_files_at(\"res://assets/textures/characters/\" + item_data.character):
			if expr.get_extension() == \"png\":
				i.get_node(\"Character/Emotion\").add_item(expr)
		i.get_node(\"Panel/TextEdit\").text_changed.connect(func():
			item_data.content = i.get_node(\"Panel/TextEdit\").text
		)
		i.get_node(\"Character/TextureRect\").texture = load(\"res://assets/textures/characters/\" + item_data.character + \"/\" + item_data.expression)
		i.get_node(\"Character/Name\").item_selected.connect(func(ind):
			item_data.character = i.get_node(\"Character/Name\").get_item_text(ind)
			i.get_node(\"Character/Emotion\").clear()
			for expr in DirAccess.get_files_at(\"res://assets/textures/characters/\" + item_data.character):
				if expr.get_extension() == \"png\":
					i.get_node(\"Character/Emotion\").add_item(expr)
			i.get_node(\"Character/TextureRect\").texture = load(\"res://assets/textures/characters/\" + item_data.character + \"/\" + item_data.expression)
		)
		i.get_node(\"Character/Emotion\").item_selected.connect(func(ind):
			item_data.expression = i.get_node(\"Character/Emotion\").get_item_text(ind)
			i.get_node(\"Character/TextureRect\").texture = load(\"res://assets/textures/characters/\" + item_data.character + \"/\" + item_data.expression)
		)
	elif item_data.type == \"choice\":
		i.get_node(\"Panel/Options/Set\").pressed.connect(func():
			var new_options = []
			for c in 5:
				var box = i.get_node(\"Panel/Options\").get_child(c)
				if box.get_node(\"Text\").text != \"\" and box.get_node(\"Dialog\").text != \"\":
					new_options.append({\"text\":box.get_node(\"Text\").text,\"dialog\":box.get_node(\"Dialog\").text})
			item_data.options = new_options.duplicate()
			for c in 5:
				var box = i.get_node(\"Panel/Options\").get_child(c)
				if item_data.options.size() > c:
					box.get_node(\"Text\").text = item_data.options[c].text
					box.get_node(\"Dialog\").text = item_data.options[c].dialog
				else:
					box.get_node(\"Text\").text = \"\"
					box.get_node(\"Dialog\").text = \"\"
		)
	elif item_data.type == \"visible\":
		i.get_node(\"Panel/CheckButton\").pressed.connect(func():
			item_data.value = i.get_node(\"Panel/CheckButton\").button_pressed
		)
	elif item_data.type == \"focus\":
		i.get_node(\"Panel/Type\").item_selected.connect(func(ind):
			item_data.object = i.get_node(\"Panel/Type\").get_item_text(ind)
		)
		i.get_node(\"Panel/LineEdit\").text_changed.connect(func(_e):
			item_data.point = i.get_node(\"Panel/LineEdit\").text
		)
	elif item_data.type == \"music\":
		i.get_node(\"Panel/Song\").item_selected.connect(func(ind):
			item_data.song = i.get_node(\"Panel/Song\").get_item_text(ind)
		)
	elif item_data.type == \"cg\":
		i.get_node(\"Panel/CheckButton\").pressed.connect(func():
			item_data.enabled = i.get_node(\"Panel/CheckButton\").button_pressed
		)
		i.get_node(\"Panel/Load\").pressed.connect(func():
			to_open = \"cg\" + str(item_data.id)
			file_dialog.set_filters([\"*.png,*.jpg\"])
			file_dialog.visible = true
			file_dialog.root_subfolder = \"assets/textures/cg\"
		)
		file_dialog.file_selected.connect(func(path):
			if to_open == \"cg\" + str(item_data.id):
				item_data.file = path
				i.get_node(\"Panel/Load\").text = path.get_file()
				i.get_node(\"Image/TextureRect\").texture = load(path)
		)
	elif item_data.type == \"sfx\":
		i.get_node(\"Panel/Load\").pressed.connect(func():
			to_open = \"sfx\" + str(item_data.id)
			file_dialog.set_filters([\"*.mp3,*.wav\"])
			file_dialog.visible = true
			file_dialog.root_subfolder = \"assets/audio/sfx\"
		)
		file_dialog.file_selected.connect(func(path):
			if to_open == \"sfx\" + str(item_data.id):
				item_data.file = path
				i.get_node(\"Panel/Load\").text = path.get_file()
		)
	elif item_data.type == \"bullet\":
		i.get_node(\"Panel/CheckButton\").pressed.connect(func():
			item_data.show = i.get_node(\"Panel/CheckButton\").button_pressed
		)
		i.get_node(\"Panel/Load\").pressed.connect(func():
			to_open = \"bullet\" + str(item_data.id)
			file_dialog.set_filters([\"*.json\"])
			file_dialog.visible = true
			file_dialog.root_subfolder = \"assets\"
		)
		file_dialog.file_selected.connect(func(path):
			file_dialog.root_subfolder = \"assets\"
			item_data.file = path
			if to_open == \"bullet\" + str(item_data.id):
				i.get_node(\"Panel/Load\").text = path.get_file()
				i.get_node(\"Panel/Bullet\").clear()
				var file = load(path).data
				if file is Dictionary:
					for key in file.keys():
						i.get_node(\"Panel/Bullet\").add_item(key)
		)
		i.get_node(\"Panel/Bullet\").item_selected.connect(func(ind):
			item_data.bullet = i.get_node(\"Panel/Bullet\").get_item_text(ind)
		)

func closest(target):
	var close = list.get_child(0).global_position.y
	var closeID = 0
	for num in list.get_child_count():
		var item = list.get_child(num)
		if abs(target-item.global_position.y) < abs(target-close):
			close = item.global_position.y
			closeID = num
	return closeID
	
func sort_new(a, b):
	if a.id < b.id:
		return true
	return false

func save():
	if file_path != \"\":
		var new_data = data.duplicate(true)
		new_data[current_dialog].sort_custom(sort_new)
		for i in new_data[current_dialog]:
			i.erase(\"id\")
			if i.has(\"eline\"):
				i.erase(\"eline\")
		for a in new_data.keys().size():
			if new_data.has(\"dialog\" + str(a)) and new_data[\"dialog\" + str(a)] != new_data[current_dialog]:
				new_data[\"dialog\" + str(a)].sort_custom(sort_new)
				for i in new_data[\"dialog\" + str(a)]:
					i.erase(\"id\")
					i.erase(\"eline\")
		print(new_data)
		var to_save = FileAccess.open(file_path, FileAccess.WRITE)
		to_save.store_string(JSON.stringify(new_data, \"\\t\"))
		to_save.close()
		self.get_node(\"Saved/Anim\").play(\"Anim\")
	
func _process(_delta: float) -> void:
	for i in data[current_dialog]:
		if i.has(\"id\") and i.has(\"eline\") and i.eline != null:
			i.id = i.eline.get_index()
	for a in data.keys().size():
		if data.has(\"dialog\" + str(a)):
			for b in data[\"dialog\" + str(a)].size():
				var i = data[\"dialog\" + str(a)][b]
				if i.has(\"id\") and i.has(\"eline\") and i.eline != null:
					i.id = b
	for i in list.get_children():
		i.get_node(\"Panel/Index\").text = str(i.get_index())
	var mouse_pos = get_viewport().get_mouse_position()
	if moving:
		list.move_child(moving, closest(mouse_pos.y-32))
	if moving and Input.is_action_just_released(\"Progress\"):
		moving.mouse_filter = Control.MOUSE_FILTER_STOP
		moving.get_node(\"Panel/Outline\").visible = false
		moving = null
	if Input.is_action_just_released(\"RMB\"):
		context_menu.visible = true
		context_menu.position = Vector2(clampf(mouse_pos.x,0,1920-262),(clampf(mouse_pos.y,0,1080-424)))
	if Input.is_action_just_pressed(\"Ctrl\"):
		print(data[current_dialog])
"

